{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/schedule.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/meta.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/schedule/options.ts": {
      "maxDuration": 30,
      "memory": 512
    }
  }
}
