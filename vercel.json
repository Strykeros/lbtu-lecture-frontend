{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/schedule/index.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/schedule/meta.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  }
}
